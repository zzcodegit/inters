#!/usr/bin/env bash

# Shared inventory template for remote vpnnode hosts.
# Copy to `scripts/hosts.env` and fill in real values for your environment.

# Standardized remote layout:
# - binary: /opt/vpnnode/bin/vpnnode
# - configs: /etc/vpnnode/*.toml
# - state: /var/lib/vpnnode/ (reserved)
# - systemd units: /etc/systemd/system/vpnnode-*.service

# Common defaults
export VPNNODE_BIN_REMOTE="/opt/vpnnode/bin/vpnnode"
export VPNNODE_CONFIG_DIR_REMOTE="/etc/vpnnode"
export VPNNODE_UNIT_DIR_REMOTE="/etc/systemd/system"

########################################
# EXIT node
########################################

export VPNNODE_EXIT_HOST="exit.example.com"
export VPNNODE_EXIT_USER="root"
export VPNNODE_EXIT_ROLE="exit"
export VPNNODE_EXIT_PORT="30000"
export VPNNODE_EXIT_CONFIG_REMOTE="${VPNNODE_CONFIG_DIR_REMOTE}/exit.toml"
export VPNNODE_EXIT_UNIT="vpnnode-exit.service"

# Local files (relative to repo root)
export VPNNODE_EXIT_CONFIG_LOCAL="examples/config/exit-remote-with-target.toml"
export VPNNODE_EXIT_UNIT_LOCAL="systemd/vpnnode-exit.service"

########################################
# RELAY #1
########################################

export VPNNODE_RELAY1_HOST="relay1.example.com"
export VPNNODE_RELAY1_USER="root"
export VPNNODE_RELAY1_ROLE="relay1"
export VPNNODE_RELAY1_PORT="30001"
export VPNNODE_RELAY1_CONFIG_REMOTE="${VPNNODE_CONFIG_DIR_REMOTE}/relay1.toml"
export VPNNODE_RELAY1_UNIT="vpnnode-relay1.service"

export VPNNODE_RELAY1_CONFIG_LOCAL="examples/config/relay-remote-1-to-relay2.toml"
export VPNNODE_RELAY1_UNIT_LOCAL="systemd/vpnnode-relay1.service"

########################################
# RELAY #2
########################################

export VPNNODE_RELAY2_HOST="relay2.example.com"
export VPNNODE_RELAY2_USER="root"
export VPNNODE_RELAY2_ROLE="relay2"
export VPNNODE_RELAY2_PORT="30002"
export VPNNODE_RELAY2_CONFIG_REMOTE="${VPNNODE_CONFIG_DIR_REMOTE}/relay2.toml"
export VPNNODE_RELAY2_UNIT="vpnnode-relay2.service"

export VPNNODE_RELAY2_CONFIG_LOCAL="examples/config/relay-remote-2.toml"
export VPNNODE_RELAY2_UNIT_LOCAL="systemd/vpnnode-relay2.service"
